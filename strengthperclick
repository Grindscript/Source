-- Name of the toggle, default state, callback
local Farm = false

window:Toggle("Fast Train", false, function(bool)
    Farm = bool

    if Farm then
        task.spawn(function()
            while Farm do
                local Event = game:GetService("ReplicatedStorage").Remotes.Events.ClickRemote
                Event:FireServer()
                task.wait()
            end
        end)
    end
end)

